# NEXORA ONE local configuration
# Copy to .env for local development. Never commit .env.

APP_NAME=NEXORA ONE API
ENVIRONMENT=development
DEBUG=false

# Repository adapters use this URL. Phase 1 defaults to an in-process repository.
# PostgreSQL example: postgresql+asyncpg://user:password@localhost:5432/nexora
DATABASE_URL=sqlite:///./data/nexora.db

# Nebius Token Factory / NVIDIA Nemotron configuration.
# NEBIUS_BASE_URL should include the OpenAI-compatible /v1 path, for example:
# https://api.tokenfactory.nebius.com/v1/
NEBIUS_API_KEY=
NEBIUS_MODEL=
NEBIUS_BASE_URL=
NEBIUS_TIMEOUT_SECONDS=60
NEBIUS_MAX_RETRIES=2

# Optional external research provider for a future controlled tool.
TAVILY_API_KEY=

# Comma-separated browser origins allowed by the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
