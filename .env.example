# NEXORA ONE local configuration
# Copy to .env for local development. Never commit .env.

APP_NAME=NEXORA ONE API
ENVIRONMENT=development
DEBUG=false

# Repository adapters use this URL. Phase 1 defaults to an in-process repository.
# PostgreSQL example: postgresql+asyncpg://user:password@localhost:5432/nexora
DATABASE_URL=sqlite:///./data/nexora.db

# Nebius Token Factory / NVIDIA Nemotron configuration.
# NEBIUS_BASE_URL should include the OpenAI-compatible /v1 path, for example:
# https://api.tokenfactory.nebius.com/v1/
NEBIUS_API_KEY=
NEBIUS_MODEL=
NEBIUS_BASE_URL=
NEBIUS_TIMEOUT_SECONDS=60
NEBIUS_MAX_RETRIES=2

# Optional external research provider for a future controlled tool.
TAVILY_API_KEY=

# Phase 9 reference security boundary. Leave empty only for development/test,
# where the server creates an ephemeral key. Production requires a secret
# manager-provided value of at least 32 characters.
SECURITY_AUTH_SECRET=
SECURITY_TOKEN_TTL_SECONDS=900
SECURITY_MAX_REQUEST_BYTES=262144

# Comma-separated browser origins allowed by the API; wildcard is rejected.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
